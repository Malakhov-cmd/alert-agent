# Agent provider: anthropic | gemini
AGENT_PROVIDER=anthropic

# Anthropic Claude (нужен при AGENT_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini (нужен при AGENT_PROVIDER=gemini)
# GOOGLE_API_KEY  — основной ключ (обязателен)
# GOOGLE_API_KEYS — дополнительные ключи через запятую, любое количество
#                   при наличии нескольких ключей агент делает один вызов на триггер
#                   (вместо одного на ISIN) → каждый триггер получает свой бюджет поиска
GOOGLE_API_KEY=AIza...
GOOGLE_API_KEYS=AIza...,AIza...,AIza...
GEMINI_MODEL=gemini-2.5-flash

# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-...
TELEGRAM_CHAT_ID=-1001234567890

# Tavily (нужен при AGENT_PROVIDER=anthropic; при gemini можно не указывать)
TAVILY_API_KEY=tvly-...

# PostgreSQL
POSTGRES_PASSWORD=changeme

# Путь к папке Obsidian vault на хосте
HOST_VAULT_PATH=/path/to/obsidian/vault

# Режим запуска: scheduled (по cron) | daily | weekly | monthly | quarterly
RUN_MODE=scheduled

# Часовой пояс (IANA): Europe/Moscow | Europe/London | Asia/Almaty | ...
MONITOR_TIMEZONE=Europe/Moscow

# Расписание запусков (cron, опционально — переопределяет дефолты из application.yml)
# Формат: секунды минуты часы день месяц день_недели
# SCHEDULE_DAILY_CRON=0 0 10 * * *
# SCHEDULE_WEEKLY_CRON=0 0 10 * * MON
# SCHEDULE_MONTHLY_CRON=0 0 10 1 * *
# SCHEDULE_QUARTERLY_CRON=0 0 10 1 1,4,7,10 *

# Пауза между вызовами в per-trigger режиме Gemini (секунды, дефолт: 2)
# GEMINI_CALL_DELAY_SEC=3
