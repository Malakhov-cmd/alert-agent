# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-...
TELEGRAM_CHAT_ID=-1001234567890

# Tavily
TAVILY_API_KEY=tvly-...

# PostgreSQL
POSTGRES_PASSWORD=changeme

# Путь к папке Obsidian vault на хосте
HOST_VAULT_PATH=/path/to/obsidian/vault

# Режим запуска: scheduled (по cron) | daily | weekly | monthly | quarterly
RUN_MODE=scheduled

# Часовой пояс (IANA): Europe/Moscow | Europe/London | Asia/Almaty | ...
MONITOR_TIMEZONE=Europe/Moscow
